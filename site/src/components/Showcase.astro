---
// A screenshot next to a short explanation; `flip` puts the screenshot on the left.
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  image: ImageMetadata
  alt: string
  kicker: string
  title: string
  flip?: boolean
}
const { image, alt, kicker, title, flip = false } = Astro.props
---

<div class:list={['showcase not-content', { flip }]}>
  <div class="showcase-copy">
    <p class="landing-eyebrow">{kicker}</p>
    <h3>{title}</h3>
    <div class="showcase-text"><slot /></div>
  </div>
  <div class="showcase-shot">
    <Image src={image} alt={alt} loading="lazy" />
  </div>
</div>

<style>
  .showcase {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  .showcase + :global(.showcase) {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  @media (min-width: 55rem) {
    .showcase {
      grid-template-columns: 5fr 7fr;
      gap: 3.5rem;
    }
    .flip {
      grid-template-columns: 7fr 5fr;
    }
    .flip .showcase-copy {
      order: 2;
    }
  }
  h3 {
    margin-top: 0.75rem;
    font: 700 clamp(1.2rem, 0.95rem + 0.8vw, 1.45rem) / 1.3 var(--ss-font-mono);
    letter-spacing: -0.02em;
    color: var(--ss-fg);
    text-wrap: balance;
  }
  .showcase-text {
    margin-top: 0.9rem;
    color: var(--ss-muted);
    line-height: 1.65;
  }
  .showcase-text :global(p + p) {
    margin-top: 0.75rem;
  }
  .showcase-text :global(a) {
    color: var(--ss-accent);
    font-weight: 600;
    text-decoration: none;
  }
  .showcase-text :global(a:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .showcase-shot {
    border-radius: 8px;
    border: 1px solid var(--ss-line);
    overflow: hidden;
  }
  .showcase-shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
