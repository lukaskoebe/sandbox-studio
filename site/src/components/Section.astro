---
// A landing page section under a hairline: a numbered eyebrow, a mono headline and a lede,
// then the section's content. `split` puts the heading in a column of its own on wide screens.
interface Props {
  number?: string
  kicker?: string
  title: string
  id?: string
  split?: boolean
}
const { number, kicker, title, id, split = false } = Astro.props
---

<section class:list={['landing-section not-content', { split }]} id={id}>
  <header class="section-head">
    {
      kicker && (
        <p class="section-kicker landing-eyebrow">
          {number && <span class="section-number">{number}</span>}
          {kicker}
        </p>
      )
    }
    <h2 set:html={title} />
    {Astro.slots.has('lede') && <div class="section-lede"><slot name="lede" /></div>}
  </header>
  <div class="section-body"><slot /></div>
</section>

<style>
  .landing-section {
    margin-top: clamp(4rem, 8vw, 6.5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--ss-line);
  }
  .section-head {
    max-width: 44rem;
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
  }
  @media (min-width: 62rem) {
    .split {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 4rem;
    }
    .split .section-head {
      margin-bottom: 0;
    }
    .split h2 {
      font-size: clamp(1.35rem, 0.9rem + 1vw, 1.7rem);
    }
  }
  .section-kicker {
    display: flex;
    gap: 0.75rem;
  }
  .section-number {
    color: var(--ss-muted);
  }
  h2 {
    margin-top: 1.1rem;
    font: 700 clamp(1.5rem, 0.95rem + 1.6vw, 2.1rem) / 1.2 var(--ss-font-mono);
    letter-spacing: -0.02em;
    color: var(--ss-fg);
    text-wrap: balance;
  }
  .section-lede {
    margin-top: 1rem;
    max-width: 68ch;
    font-size: var(--sl-text-base);
    line-height: 1.6;
    color: var(--ss-muted);
    text-wrap: pretty;
  }
  .section-body {
    min-width: 0;
  }
</style>
