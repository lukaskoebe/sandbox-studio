---
// A landing page section: a kicker, a headline and a lede, then the section's content.
interface Props {
  kicker?: string
  title: string
  id?: string
}
const { kicker, title, id } = Astro.props
---

<section class="landing-section not-content" id={id}>
  <header class="section-head">
    {kicker && <p class="section-kicker">{kicker}</p>}
    <h2 set:html={title} />
    {Astro.slots.has('lede') && <div class="section-lede"><slot name="lede" /></div>}
  </header>
  <slot />
</section>

<style>
  .landing-section {
    margin-top: clamp(4.5rem, 10vw, 7.5rem);
  }
  .section-head {
    max-width: 44rem;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    text-align: center;
  }
  .section-kicker {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
  }
  h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.9rem, 1rem + 3vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 680;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .section-lede {
    margin-top: 1rem;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
</style>
