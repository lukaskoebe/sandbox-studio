---
// A grid of features divided by hairlines, each with a small icon, a title, a sentence or two
// and an optional link.
import LineIcon from './LineIcon.astro'

interface Feature {
  icon: Parameters<typeof LineIcon>[0]['name']
  title: string
  text: string
  link?: string
}
interface Props {
  items: Feature[]
  columns?: 2 | 3
}
const { items, columns = 3 } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<ul class:list={['features', `cols-${columns}`]}>
  {
    items.map((f) => (
      <li class="feature">
        <h3>
          <LineIcon name={f.icon} />
          {f.title}
        </h3>
        <p>{f.text}</p>
        {f.link && (
          <a class="feature-link" href={`${base}${f.link}`}>
            Read the guide <span aria-hidden="true">→</span>
          </a>
        )}
      </li>
    ))
  }
</ul>

<style>
  /* The hairlines are the grid's background showing through 1px gaps. */
  .features {
    display: grid;
    gap: 1px;
    padding: 0;
    margin: 0;
    list-style: none;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    background: var(--sl-color-hairline-light);
    overflow: hidden;
  }
  @media (min-width: 45rem) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 62rem) {
    .cols-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .feature {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.35rem;
    background: var(--sl-color-black);
    transition: background-color 0.15s;
  }
  .feature:has(.feature-link):hover {
    background: var(--ss-surface);
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    line-height: 1.3;
    font-size: var(--sl-text-base);
    font-weight: 620;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }
  h3 :global(svg) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--sl-color-text-accent);
  }
  p {
    margin-top: 0.6rem;
    font-size: var(--sl-text-sm);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }
  .feature-link {
    margin-top: auto;
    padding-top: 1rem;
    font-size: var(--sl-text-xs);
    font-weight: 550;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .feature:hover .feature-link {
    color: var(--sl-color-text-accent);
  }
  .feature-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
