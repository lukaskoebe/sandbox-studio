---
// A grid of features, each with an icon, a title, a sentence or two and an optional link.
import LineIcon from './LineIcon.astro'

interface Feature {
  icon: Parameters<typeof LineIcon>[0]['name']
  title: string
  text: string
  link?: string
}
interface Props {
  items: Feature[]
  columns?: 2 | 3
}
const { items, columns = 3 } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<ul class:list={['features', `cols-${columns}`]}>
  {
    items.map((f) => (
      <li class="feature">
        <span class="feature-icon">
          <LineIcon name={f.icon} />
        </span>
        <h3>{f.title}</h3>
        <p>{f.text}</p>
        {f.link && (
          <a class="feature-link" href={`${base}${f.link}`}>
            Read more <span aria-hidden="true">→</span>
          </a>
        )}
      </li>
    ))
  }
</ul>

<style>
  .features {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  @media (min-width: 45rem) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 62rem) {
    .cols-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .feature {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--sl-color-hairline-light);
    background: var(--ss-surface);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .feature:hover {
    border-color: var(--ss-green-border);
  }
  .feature-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: var(--ss-green-soft);
    color: var(--ss-green);
  }
  .feature-icon :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }
  h3 {
    margin-top: 1rem;
    line-height: 1.3;
    font-size: var(--sl-text-lg);
    font-weight: 640;
    letter-spacing: -0.015em;
    color: var(--sl-color-white);
  }
  p {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }
  .feature-link {
    margin-top: auto;
    padding-top: 1rem;
    font-size: var(--sl-text-sm);
    font-weight: 560;
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  .feature-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .feature-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
