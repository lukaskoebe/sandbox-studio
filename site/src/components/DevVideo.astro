---
// The technical video for the landing page's "Under the hood" section. It loads and plays
// once it scrolls into view, so the page doesn't download it up front.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<figure class="dev-video not-content">
  <video
    muted
    loop
    playsinline
    preload="none"
    data-autoplay-in-view
    poster={`${base}video/developers.jpg`}
    aria-label="Coding agents in their own microVMs, with egress approvals, credentials that never enter the VM, and review before a push reaches the forge"
  >
    <source src={`${base}video/developers.webm`} type="video/webm" />
    <source src={`${base}video/developers.mp4`} type="video/mp4" />
  </video>
</figure>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
  for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-autoplay-in-view]')) {
    if (reduced || !('IntersectionObserver' in window)) {
      video.controls = true
      continue
    }
    new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) video.play().catch(() => (video.controls = true))
          else video.pause()
        }
      },
      { threshold: 0.35 }
    ).observe(video)
  }
</script>

<style>
  .dev-video {
    margin: 0 0 2rem;
    padding: 0.5rem;
    border-radius: 1.25rem;
    border: 1px solid var(--sl-color-hairline-light);
    background: var(--ss-surface);
    box-shadow: 0 30px 90px -40px rgba(0, 0, 0, 0.6);
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 0.8rem;
    background: #0b0e10;
  }
  @media (max-width: 40rem) {
    .dev-video {
      padding: 0.25rem;
      border-radius: 0.9rem;
    }
  }
</style>
