---
// The landing page's closing call to action.
import { LinkButton } from '@astrojs/starlight/components'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<section class="closing not-content">
  <div>
    <h2>Start with one teammate and one sandbox.</h2>
    <p>Free and open source under the Apache 2.0 license.</p>
  </div>
  <div class="closing-actions">
    <LinkButton href={`${base}getting-started/`} icon="right-arrow">Get started</LinkButton>
    <LinkButton href="https://github.com/lukaskoebe/sandbox-studio" variant="secondary" icon="github">
      GitHub
    </LinkButton>
  </div>
</section>

<style>
  .closing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(4.5rem, 9vw, 7rem);
    padding: 2.5rem 0 1rem;
    border-top: 1px solid var(--sl-color-hairline-light);
  }
  h2 {
    font-size: clamp(1.6rem, 1rem + 1.8vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 660;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  p {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
  }
  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
