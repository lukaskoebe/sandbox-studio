---
// The landing page's closing call to action, on a card of its own.
import { LinkButton } from '@astrojs/starlight/components'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<section class="closing not-content">
  <div>
    <h2>Start with one teammate and one sandbox.</h2>
    <p>Free and open source under the Apache 2.0 license.</p>
  </div>
  <div class="closing-actions">
    <LinkButton href={`${base}getting-started/`} icon="right-arrow">Get started</LinkButton>
    <LinkButton href="https://github.com/lukaskoebe/sandbox-studio" variant="secondary" icon="github">
      GitHub
    </LinkButton>
  </div>
</section>

<style>
  .closing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(4rem, 8vw, 6.5rem);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid var(--ss-line);
    border-radius: 10px;
    background: var(--ss-surface);
  }
  h2 {
    font: 700 clamp(1.3rem, 0.9rem + 1.2vw, 1.7rem) / 1.25 var(--ss-font-mono);
    letter-spacing: -0.02em;
    color: var(--ss-fg);
    text-wrap: balance;
  }
  p {
    margin-top: 0.5rem;
    color: var(--ss-muted);
  }
  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
