---
// The landing page's hero: the headline and actions from the page's frontmatter, the install
// command on a terminal panel, and the overview video. Only the landing page sets `hero`, so
// this replaces Starlight's hero there and nowhere else.
import { LinkButton } from '@astrojs/starlight/components'

const { data } = Astro.locals.starlightRoute.entry
const { title = data.title, tagline, actions = [] } = data.hero || {}
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const install = 'curl -fsSL https://raw.githubusercontent.com/lukaskoebe/sandbox-studio/main/install.sh | sh'

const video = {
  name: 'overview',
  label: 'Overview',
  length: '0:50',
  alt: 'A coding agent gets its own microVM on your computer: your files stay out of its reach, a website it has not used before asks you first, copies run Claude Code, Codex and opencode side by side, and its push waits for your review',
}
---

<div class="landing-hero not-content">
  <p class="hero-meta landing-eyebrow">
    <a href="https://github.com/lukaskoebe/sandbox-studio/releases">Releases</a>
    <span aria-hidden="true">/</span>
    Apache-2.0
    <span aria-hidden="true">/</span>
    Linux, macOS, Windows (preview)
  </p>
  <h1 id="_top" data-page-title set:html={title} />
  <div class="hero-body">
    {tagline && <p class="hero-tagline" set:html={tagline} />}
    <div class="hero-start">
      <div class="hero-actions">
        {
          actions.map(({ link: href, text, variant, icon }) => (
            <LinkButton href={href} variant={variant} icon={icon?.name}>
              {text}
            </LinkButton>
          ))
        }
      </div>
      <div class="hero-install">
        <code><span class="install-prompt" aria-hidden="true">$ </span>{install}</code>
        <button type="button" class="install-copy" data-copy={install} aria-label="Copy the install command">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path></svg>
          <span class="copy-label">Copy</span>
        </button>
      </div>
    </div>
  </div>

  <figure class="hero-player" data-player>
    <div class="player-bar">
      <span class="player-title">
        {video.label}
        <span class="player-length">{video.length}</span>
      </span>
      <button type="button" class="player-toggle" data-toggle aria-label="Pause the video">
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"></path></svg>
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l12 7-12 7z"></path></svg>
      </button>
    </div>
    <div class="player-progress" aria-hidden="true"><span data-progress></span></div>
    <video
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={`${base}video/${video.name}.jpg`}
      aria-label={video.alt}
    >
      <source src={`${base}video/${video.name}.webm`} type="video/webm" />
      <source src={`${base}video/${video.name}.mp4`} type="video/mp4" />
    </video>
  </figure>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.install-copy')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '')
      } catch {
        return
      }
      const label = button.querySelector('.copy-label')
      if (!label) return
      label.textContent = 'Copied'
      setTimeout(() => (label.textContent = 'Copy'), 1600)
    })
  }

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
  for (const player of document.querySelectorAll<HTMLElement>('[data-player]')) {
    const video = player.querySelector('video')!
    const toggle = player.querySelector<HTMLButtonElement>('[data-toggle]')!
    const progress = player.querySelector<HTMLElement>('[data-progress]')!

    // Reduced motion: show the first frame and the video's own controls instead of playing.
    if (reduced) {
      video.removeAttribute('autoplay')
      video.pause()
      video.controls = true
      toggle.hidden = true
    }
    const sync = () => {
      player.toggleAttribute('data-paused', video.paused)
      toggle.setAttribute('aria-label', video.paused ? 'Play the video' : 'Pause the video')
    }
    video.addEventListener('play', sync)
    video.addEventListener('pause', sync)
    video.addEventListener('timeupdate', () => {
      progress.style.transform = `scaleX(${video.duration ? video.currentTime / video.duration : 0})`
    })
    const flip = () => (video.paused ? video.play().catch(() => (video.controls = true)) : video.pause())
    toggle.addEventListener('click', flip)
    video.addEventListener('click', () => !video.controls && flip())

    sync()
  }
</script>

<style>
  .landing-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
  }
  .hero-meta span {
    color: var(--ss-muted);
  }
  .hero-meta a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--ss-green-border);
    text-underline-offset: 3px;
  }
  .hero-meta a:hover {
    text-decoration-color: currentColor;
  }
  h1 {
    margin-top: 1.25rem;
    max-width: 22ch;
    font: 700 clamp(2rem, 0.9rem + 3.6vw, 3.4rem) / 1.12 var(--ss-font-mono);
    letter-spacing: -0.035em;
    color: var(--ss-fg);
    text-wrap: balance;
  }
  .hero-body {
    display: grid;
    gap: 2rem;
    margin-top: 1.75rem;
  }
  @media (min-width: 62rem) {
    .hero-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: end;
    }
  }
  .hero-tagline {
    max-width: 36rem;
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.2rem);
    line-height: 1.6;
    color: var(--ss-muted);
    text-wrap: pretty;
  }
  .hero-start {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  /* The install command on a terminal panel, with a green prompt. */
  .hero-install {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.45rem 0.45rem 0.45rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--t-edge);
    background: var(--t-bg);
    font-family: var(--ss-font-mono);
    font-size: 0.8rem;
  }
  .install-prompt {
    color: var(--t-ok);
    font-weight: 700;
    user-select: none;
  }
  .hero-install code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    color: var(--t-fg);
    font-size: inherit;
    font-variant-ligatures: none;
    scrollbar-width: none;
  }
  /* Copy, as a keycap. */
  .install-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    padding: 0.3rem 0.55rem;
    border-radius: 4px;
    border: 1px solid var(--ss-line);
    border-bottom-width: 2px;
    background: var(--ss-surface);
    color: var(--ss-fg);
    font: 600 0.75rem / 1 var(--ss-font-mono);
    cursor: pointer;
  }
  .install-copy:hover {
    border-color: var(--ss-muted);
  }
  .install-copy svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .hero-player {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    border-radius: 8px;
    border: 1px solid var(--ss-line);
    background: var(--ss-surface);
    overflow: hidden;
  }
  .player-bar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px solid var(--ss-line);
  }
  .player-title {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    min-width: 0;
    padding: 0.7rem 1rem;
    color: var(--ss-fg);
    font: 600 0.8rem / 1.2 var(--ss-font-mono);
  }
  .player-toggle:focus-visible {
    outline: 2px solid var(--ss-accent);
    outline-offset: -2px;
  }
  .player-length {
    font-weight: 400;
    color: var(--ss-muted);
  }
  .player-toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    border: 0;
    border-inline-start: 1px solid var(--ss-line);
    background: none;
    color: var(--ss-muted);
    cursor: pointer;
  }
  .player-toggle:hover {
    color: var(--ss-fg);
  }
  .player-toggle svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-play,
  [data-paused] .icon-pause {
    display: none;
  }
  [data-paused] .icon-play {
    display: block;
  }
  .player-progress {
    height: 1px;
    background: var(--ss-line);
  }
  .player-progress span {
    display: block;
    height: 100%;
    background: var(--ss-accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .hero-player video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #0b0e10;
    cursor: pointer;
  }
  @media (max-width: 40rem) {
    .copy-label {
      display: none;
    }
    .player-title {
      padding-inline: 0.8rem;
    }
  }
</style>
