---
// The landing page's install steps, with the command for each platform.
import { Code, Tabs, TabItem } from '@astrojs/starlight/components'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<div class="install not-content">
  <ol class="install-steps">
    <li>
      <h3>Install the <code>studio</code> binary</h3>
      <p>One file, installed to <code>~/.local/bin</code> without sudo.</p>
      <Tabs syncKey="os">
        <TabItem label="Linux and macOS">
          <Code
            lang="sh"
            frame="none"
            wrap
            code="curl -fsSL https://raw.githubusercontent.com/lukaskoebe/sandbox-studio/main/install.sh | sh"
          />
        </TabItem>
        <TabItem label="Windows">
          <p class="install-tab-text">
            Turn on the Windows Hypervisor Platform and reboot. Then download the Windows archive
            from <a href="https://github.com/lukaskoebe/sandbox-studio/releases">Releases</a>,
            check it against <code>checksums.txt</code>, and put <code>studio.exe</code> on your
            <code>PATH</code>.
          </p>
        </TabItem>
      </Tabs>
    </li>
    <li>
      <h3>Check the machine and start Studio</h3>
      <p>Studio prints a one-time login link for its local UI.</p>
      <Code lang="sh" frame="none" code={'studio doctor\nstudio'} />
    </li>
    <li>
      <h3>Follow the guided setup</h3>
      <p>
        Connect an AI provider, meet your first teammate and create a sandbox. Every step can be skipped and picked up later.
      </p>
    </li>
  </ol>
  <p class="install-note">
    Needs Linux with KVM, macOS on Apple Silicon, or Windows 11 (preview), and about 5 GB of free
    disk. <a href={`${base}getting-started/`}>Getting started</a> has the details.
  </p>
</div>

<style>
  .install-steps {
    counter-reset: step;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .install-steps > li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--ss-line);
  }
  .install-steps > li:first-child {
    padding-top: 0;
  }
  .install-steps > li::before {
    content: counter(step, decimal-leading-zero);
    padding-top: 0.2rem;
    color: var(--ss-accent);
    font: 700 0.8rem / 1.4 var(--ss-font-mono);
  }
  .install-steps > li > :global(*) {
    grid-column: 2;
  }
  h3 {
    font: 600 1.0625rem / 1.35 var(--__sl-font);
    color: var(--ss-fg);
  }
  h3 code,
  p code {
    padding: 0.1em 0.35em;
    border: 1px solid var(--ss-line);
    border-radius: 4px;
    background: var(--ss-surface);
  }
  p {
    margin-top: 0.35rem;
    font-size: var(--sl-text-sm);
    color: var(--ss-muted);
    line-height: 1.6;
  }
  .install-steps :global(starlight-tabs),
  .install-steps :global(.expressive-code) {
    margin-top: 1rem;
  }
  .install-steps :global([role='tab']) {
    font: 600 0.8rem / 1.2 var(--ss-font-mono);
  }
  .install-tab-text {
    margin-top: 1rem;
  }
  .install-tab-text a,
  .install-note a {
    color: var(--ss-accent);
    font-weight: 600;
  }
  .install-note {
    margin-top: 1.25rem;
    font-size: var(--sl-text-sm);
    color: var(--ss-muted);
  }
</style>
