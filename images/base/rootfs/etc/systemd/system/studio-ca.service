[Unit]
Description=Trust the Sandbox Studio CA
Before=docker.service studio-agent.service
ConditionPathExists=/opt/studio/ca.crt

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'cp /opt/studio/ca.crt /usr/local/share/ca-certificates/sandbox-studio.crt && update-ca-certificates'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
