<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sandbox Studio.app, around studio-app (scripts/macos-app.sh fills in the version). macOS
     shows the system's notifications only for a bundle with an identifier (docs/app.md). -->
<plist version="1.0">
<dict>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleName</key>
	<string>Sandbox Studio</string>
	<key>CFBundleDisplayName</key>
	<string>Sandbox Studio</string>
	<key>CFBundleExecutable</key>
	<string>studio-app</string>
	<key>CFBundleIdentifier</key>
	<string>dev.sandbox-studio.app</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleIconFile</key>
	<string>icons</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Studio serves DevTools and keyed previews on *.localhost over plain http. App Transport
	     Security lets the app load its 127.0.0.1 page but blocked those names in the bundle. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
