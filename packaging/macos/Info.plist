<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sandbox Studio.app, around studio-app (scripts/macos-app.sh fills in the version). macOS
     shows the system's notifications only for a bundle with an identifier (docs/app.md). -->
<plist version="1.0">
<dict>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleName</key>
	<string>Sandbox Studio</string>
	<key>CFBundleDisplayName</key>
	<string>Sandbox Studio</string>
	<key>CFBundleExecutable</key>
	<string>studio-app</string>
	<key>CFBundleIdentifier</key>
	<string>dev.sandbox-studio.app</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleIconFile</key>
	<string>icons</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
