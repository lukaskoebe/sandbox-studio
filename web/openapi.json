{
  "components": {
    "schemas": {
      "AgentInfo": {
        "additionalProperties": false,
        "properties": {
          "arch": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "arch"
        ],
        "type": "object"
      },
      "CreateEnvBody": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreateRequest": {
        "additionalProperties": false,
        "properties": {
          "cpus": {
            "format": "int64",
            "type": "integer"
          },
          "dockerMiB": {
            "format": "int64",
            "type": "integer"
          },
          "memoryMiB": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "workspaceMiB": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "Environment": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "type": "object"
      },
      "PreviewPort": {
        "additionalProperties": false,
        "properties": {
          "port": {
            "format": "int64",
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "port",
          "url"
        ],
        "type": "object"
      },
      "Session": {
        "additionalProperties": false,
        "properties": {
          "attached": {
            "format": "int64",
            "type": "integer"
          },
          "created": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "windows": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "attached",
          "windows",
          "created"
        ],
        "type": "object"
      },
      "View": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/AgentInfo"
          },
          "cpus": {
            "format": "int64",
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "dockerMiB": {
            "format": "int64",
            "type": "integer"
          },
          "environmentId": {
            "type": "string"
          },
          "generation": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "memoryMiB": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "absent",
              "created",
              "starting",
              "running",
              "draining",
              "paused",
              "stopped",
              "crashed"
            ],
            "type": "string"
          },
          "workspaceMiB": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "id",
          "environmentId",
          "name",
          "generation",
          "cpus",
          "memoryMiB",
          "workspaceMiB",
          "dockerMiB",
          "createdAt"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Sandbox Studio",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/environments": {
      "get": {
        "operationId": "listEnvironments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Environment"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "tags": [
          "environments"
        ]
      },
      "post": {
        "operationId": "createEnvironment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEnvBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Environment"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "tags": [
          "environments"
        ]
      }
    },
