    "/api/environments/{env}/sandboxes/{id}/terminals": {
      "get": {
        "description": "Terminals are tmux sessions; attach over a websocket at .../terminals/{name}/attach.",
        "operationId": "listTerminals",
        "parameters": [
          {
            "description": "Environment ID",
            "in": "path",
            "name": "env",
            "required": true,
            "schema": {
              "description": "Environment ID",
              "type": "string"
            }
          },
          {
            "description": "Sandbox ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Sandbox ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Session"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
