        ]
      }
    },
    "/api/environments/{env}/sandboxes/{id}/terminals/{name}": {
      "delete": {
        "operationId": "closeTerminal",
        "parameters": [
          {
            "description": "Environment ID",
            "in": "path",
            "name": "env",
            "required": true,
            "schema": {
              "description": "Environment ID",
              "type": "string"
            }
          },
          {
            "description": "Sandbox ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Sandbox ID",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
